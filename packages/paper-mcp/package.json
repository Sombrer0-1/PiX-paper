{
	"name": "pi-paper-mcp",
	"version": "0.1.0",
	"description": "Paper-focused MCP server for PiX: academic search, PDF fulltext fetch/parse, figure extraction, BibTeX, citation support checks",
	"type": "module",
	"main": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"bin": {
		"pi-paper-mcp": "./dist/index.js"
	},
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js",
			"default": "./dist/index.js"
		}
	},
	"files": [
		"dist"
	],
	"scripts": {
		"clean": "shx rm -rf dist",
		"build": "tsgo -p tsconfig.build.json && shx chmod +x dist/index.js"
	},
	"dependencies": {
		"@modelcontextprotocol/sdk": "1.29.0",
		"pdfjs-dist": "4.10.38",
		"pngjs": "7.0.0",
		"zod": "3.25.76"
	},
	"devDependencies": {
		"@types/node": "24.12.4",
		"@types/pngjs": "6.0.5",
		"shx": "0.4.0",
		"typescript": "5.9.3"
	},
	"license": "MIT",
	"engines": {
		"node": ">=22.19.0"
	}
}
